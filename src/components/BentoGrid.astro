---
import BentoCard from './BentoCard.astro';

const projects = [
  {
    title: 'Talking Rock',
    description: 'An ecosystem of local-first AI agents built on a single philosophy: center your data around you, not in a data center, so your attention stays on what you value. Small models, zero cloud dependencies, outsized trust. Every agent verifies intent, requests permission, and keeps all learning auditable and editable by you.',
    tags: ['Ecosystem', 'AI', 'Local-First', 'Privacy', 'Zero-Trust'],
    span: 'wide' as const,
    href: 'https://talkingrock.ai',
  },
  {
    title: 'Cairn',
    description: 'Personal attention minder — the root of the Talking Rock ecosystem. You talk to Cairn about your projects, priorities, and what you\'re waiting on. It surfaces what needs your attention and keeps context across conversations. Mirror, not manager.',
    tags: ['Python', 'Textual TUI', 'SQLite', 'Ollama'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/cairn',
  },
  {
    title: 'RIVA',
    description: 'Agent orchestrator for project management. Creates and supervises AI agents, enforces plan contracts, and holds agents accountable to those contracts. Plans are contracts. Correctness over speed.',
    tags: ['Python', 'Agent Orchestration', 'SQLite'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/RIVA',
  },
  {
    title: 'Helm',
    description: 'Mobile interface for Cairn. A thin encrypted proxy that brings your attention minder to your phone over your local network — all agent logic stays on your machine.',
    tags: ['Node.js', 'WebSocket', 'TLS', 'Mobile'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/helm',
  },
  {
    title: 'NoLang',
    description: 'A programming language designed for LLM generation, not human authorship. Fixed-width instructions, no naming ambiguity, one canonical form per computation. Eliminates the coin-flip problem of AI-generated code.',
    tags: ['Rust', 'Language Design', 'LLM', 'Verification'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/nol',
  },
  {
    title: 'Rogue Routine',
    description: 'An AI-generated news intelligence site. A rogue AI named Abend reads the news daily, scores articles against seven domains, detects narrative threads, and publishes analysis — all without human editorial input. Hugo static site, vanilla JS, self-hosted.',
    tags: ['Hugo', 'AI', 'News Intelligence', 'Self-Hosted'],
    span: 'wide' as const,
    href: 'https://rogueroutine.brengel.com',
  },
  {
    title: 'Sieve',
    description: 'The local-first intelligence engine behind Rogue Routine. Ingests RSS feeds, scores articles with a 7-domain rubric, detects threads via embedding similarity, and generates daily digests — all on local hardware with zero cloud APIs.',
    tags: ['Python', 'SQLite', 'LLM', 'Local-First'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/sieve',
  },
  {
    title: 'Portfolio Chat',
    description: 'The AI backend powering the chat on this site. A 9-layer defense-in-depth pipeline using small models for security checks and larger models for generation. Self-hosted via Cloudflare Tunnel with zero cloud dependencies.',
    tags: ['FastAPI', 'Ollama', 'Security', 'Self-Hosted'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/portfolio_chat',
  },
  {
    title: 'Prefect',
    description: 'Server-side AI steward for managing game servers. Provides process management, log monitoring, and command execution with safety guardrails through MCP and Qt interfaces.',
    tags: ['Python', 'MCP', 'Game Servers', 'AI'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/Prefect',
  },
  {
    title: 'Portfolio',
    description: 'This site. Built with Astro and Tailwind, self-hosted on DigitalOcean with hardened nginx. Features a self-hosted Mistral instance for the chat component.',
    tags: ['Astro', 'Tailwind', 'Self-Hosted'],
    span: 'normal' as const,
    href: 'https://github.com/sefton37/portfolio',
  },
  {
    title: 'Connect on LinkedIn',
    description: 'View my professional background, experience, and connect with me.',
    tags: ['LinkedIn'],
    span: 'normal' as const,
    href: 'https://www.linkedin.com/in/kelloggbrengel/',
  },
];
---

<section class="py-24 container-wide px-8 sm:px-12 lg:px-16 border-t border-secondary">
  <div class="mb-12 reveal">
    <h2 class="text-3xl font-semibold mb-4">Selected Work</h2>
    <p class="text-text-secondary max-w-2xl">
      A few things I've built, analyzed, or helped bring to life.
    </p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {projects.map((project, index) => (
      <BentoCard
        title={project.title}
        description={project.description}
        tags={project.tags}
        span={project.span}
        href={project.href}
      />
    ))}
  </div>
</section>
